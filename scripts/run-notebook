#!/usr/bin/env bash
# Execute a notebook headlessly, in place: the repo copy keeps the outputs of its latest run.
#     run-notebook                        # runs notebooks/atlas.ipynb
#     run-notebook notebooks/other.ipynb
set -euo pipefail
: "${PROJECT_PATH:?source setup.sh first}"
nb="${1:-${PROJECT_PATH}/notebooks/atlas.ipynb}"
jupyter nbconvert --to notebook --execute --inplace "${nb}" \
    --ExecutePreprocessor.kernel_name=gpt2-atlas \
    --ExecutePreprocessor.timeout=1800
