#!/usr/bin/env bash
# Stage 1 activation atlas for GPT-2 small: tokenize a corpus, accumulate statistics, export Parquet.
#     run-atlas                                  # 1M OpenWebText tokens into results/atlas
#     run-atlas results/atlas-2M 2e6
#     run-atlas results/atlas-fineweb 1e6 fineweb  # another corpus: owt, fineweb or code
# For sharding, call the steps directly: python -m atlas {tokenize,run,export} --help
set -euo pipefail
: "${PROJECT_PATH:?source setup.sh first}"
dir="${1:-${PROJECT_PATH}/results/atlas}"
n_tokens="${2:-1e6}"
dataset="${3:-owt}"
python -m atlas tokenize "${dir}" --n-tokens "${n_tokens}" --dataset "${dataset}"  # 8 files, 1 window per document
python -m atlas run "${dir}" --shards 16                                          # 2 shards per file, for bootstrap errors
python -m atlas export "${dir}"
